# 钉钉开放平台配置
# 在钉钉开放平台创建企业内部应用后获取
# 文档: https://open.dingtalk.com/document/orgapp/obtain-orgapp-token

DINGTALK_APP_KEY=your_app_key_here
DINGTALK_APP_SECRET=your_app_secret_here

# 多维表ID（在钉钉文档中打开多维表时从URL获取）
DINGTALK_TABLE_ID=your_table_id_here

# 同步API密钥（可选，用于保护同步接口）
# 如果留空，则不启用鉴权
SYNC_API_KEY=your_secure_api_key_here

# 应用部署地址（用于CORS等，可选）
NEXT_PUBLIC_APP_URL=http://localhost:3000
